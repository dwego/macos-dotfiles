{
  "title": "macOS Super Key",
  "rules": [
    {
      "description": "Caps Lock: Escape when tapped, Hyper when held",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_shift",
              "modifiers": [
                "left_command",
                "left_control",
                "left_option"
              ],
              "lazy": true
            }
          ],
          "to_if_alone": [
            {
              "key_code": "escape"
            }
          ],
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 250
          }
        }
      ]
    },
    {
      "description": "Super key application launchers",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "mandatory": [
                "command",
                "control",
                "option",
                "shift"
              ]
            }
          },
          "to": [
            {
              "shell_command": "/usr/bin/open -a 'Ghostty'"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "r",
            "modifiers": {
              "mandatory": [
                "command",
                "control",
                "option",
                "shift"
              ]
            }
          },
          "to": [
            {
              "shell_command": "/usr/bin/open -a 'RustRover'"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": [
                "command",
                "control",
                "option",
                "shift"
              ]
            }
          },
          "to": [
            {
              "shell_command": "/usr/bin/open -a 'Claude'"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "b",
            "modifiers": {
              "mandatory": [
                "command",
                "control",
                "option",
                "shift"
              ]
            }
          },
          "to": [
            {
              "shell_command": "/usr/bin/open 'https://www.google.com'"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "f",
            "modifiers": {
              "mandatory": [
                "command",
                "control",
                "option",
                "shift"
              ]
            }
          },
          "to": [
            {
              "shell_command": "/usr/bin/open -a 'Finder'"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "comma",
            "modifiers": {
              "mandatory": [
                "command",
                "control",
                "option",
                "shift"
              ]
            }
          },
          "to": [
            {
              "shell_command": "/usr/bin/open -b 'com.apple.systempreferences'"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "q",
            "modifiers": {
              "mandatory": [
                "command",
                "control",
                "option",
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "w",
              "modifiers": [
                "command"
              ]
            }
          ]
        }
      ]
    }
  ]
}
